{
  "name": "mise-cocina",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:native": "tsc -b && vite build --mode native",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "check:public": "node scripts/check-public-docs.mjs",
    "android:add": "cap add android",
    "android:sync": "npm run build:native && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/app": "latest",
    "@capacitor/core": "latest",
    "@capacitor/haptics": "latest",
    "@capacitor/local-notifications": "latest",
    "@capacitor/preferences": "latest",
    "@capacitor/status-bar": "latest",
    "ajv": "latest",
    "react": "latest",
    "react-dom": "latest",
    "workbox-window": "latest"
  },
  "devDependencies": {
    "@capacitor/android": "latest",
    "@capacitor/cli": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "latest",
    "vitest": "latest"
  }
}
