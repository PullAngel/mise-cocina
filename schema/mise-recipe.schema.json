{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mise/schema/mise-recipe.schema.json",
  "title": "Mise Recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "recipeId", "revision", "locale", "title", "servings", "context", "ingredients", "components", "steps", "finish"],
  "properties": {
    "format": { "const": "mise.recipe" },
    "version": { "type": "string", "pattern": "^1\\.[0-2](?:-draft)?$" },
    "recipeId": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "revision": { "type": "integer", "minimum": 1 },
    "locale": { "type": "string", "minLength": 2 },
    "title": { "type": "string", "minLength": 1 },
    "servings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count"],
      "properties": {
        "count": { "type": "number", "exclusiveMinimum": 0 },
        "note": { "type": "string" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "equipment", "constraints", "dietary", "availableIngredients", "decisions", "uncertainties"],
      "properties": {
        "goal": { "type": "string" },
        "equipment": { "$ref": "#/$defs/stringList" },
        "constraints": { "$ref": "#/$defs/stringList" },
        "dietary": { "$ref": "#/$defs/stringList" },
        "availableIngredients": { "$ref": "#/$defs/stringList" },
        "decisions": { "$ref": "#/$defs/stringList" },
        "uncertainties": { "$ref": "#/$defs/stringList" }
      }
    },
    "ingredients": {
      "type": "array",
      "items": { "$ref": "#/$defs/ingredient" }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "finish": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storage": { "type": "string" },
        "transport": { "type": "string" },
        "reheat": { "type": "string" }
      }
    },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string" }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "text": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["value", "unit"] },
        { "required": ["min", "max", "unit"] },
        { "required": ["text"] }
      ]
    },
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "amount"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "amount": { "$ref": "#/$defs/quantity" },
        "optional": { "type": "boolean" },
        "scaling": { "enum": ["linear", "batch", "to-taste", "fixed"] },
        "scalingNote": { "type": "string" },
        "kind": { "enum": ["protein", "vegetable", "grain", "liquid", "seasoning", "fat", "dairy", "other"] }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "role": { "enum": ["main", "sauce", "garnish", "salad", "drink", "dessert", "topping", "other"] },
        "preferredStation": { "type": "string" },
        "hold": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string" },
            "qualityWindowMinutes": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "stepAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ingredientId", "value", "unit"],
      "properties": {
        "ingredientId": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sense", "cue"],
      "properties": {
        "sense": { "enum": ["visual", "texture", "smell", "taste", "sound", "time", "temperature"] },
        "cue": { "type": "string", "minLength": 1 }
      }
    },
    "timer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "durationSeconds", "startTrigger"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "durationSeconds": { "type": "integer", "minimum": 1 },
        "startTrigger": { "enum": ["user-confirmed"] }
      }
    },
    "rescue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "do"],
      "properties": {
        "when": { "type": "string", "minLength": 1 },
        "do": { "type": "string", "minLength": 1 }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "componentId", "action", "amounts", "startWhen", "doneWhen", "dependsOn", "canRunWith", "avoid", "rescues", "voice"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "componentId": { "type": "string", "minLength": 1 },
        "shortLabel": { "type": "string", "minLength": 2, "maxLength": 32 },
        "status": { "enum": ["pending", "available", "active", "waiting", "done", "blocked"] },
        "action": { "type": "string", "minLength": 1 },
        "amounts": { "type": "array", "items": { "$ref": "#/$defs/stepAmount" } },
        "heat": { "type": "string" },
        "startWhen": { "type": "string", "minLength": 1 },
        "doneWhen": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cue" } },
        "timer": { "$ref": "#/$defs/timer" },
        "dependsOn": { "$ref": "#/$defs/stringList" },
        "canRunWith": { "$ref": "#/$defs/stringList" },
        "avoid": { "$ref": "#/$defs/stringList" },
        "rescues": { "type": "array", "items": { "$ref": "#/$defs/rescue" } },
        "voice": { "type": "string" }
      }
    }
  }
}
